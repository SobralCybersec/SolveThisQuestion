# Preferred: RustProxyHub OpenAI-compatible hub.
RUST_PROXY_HUB_URL=http://127.0.0.1:3100
RUST_PROXY_HUB_API_KEY=
RUST_PROXY_HUB_MODEL=chatgpt:chatgpt-web-session
RUST_PROXY_HUB_CHATGPT_MODE=web
RUST_PROXY_HUB_SESSION_ID=screen-agent

# Generic OpenAI-compatible fallback. Used when RUST_PROXY_HUB_* values are absent.
GPT_PROXY_URL=
GPT_PROXY_API_KEY=
GPT_PROXY_MODEL=chatgpt:chatgpt-web-session
GPT_PROXY_CHATGPT_MODE=web
GPT_PROXY_SESSION_ID=screen-agent
SCREEN_AGENT_PORT=8787

# Speed vs. depth for desktop captures. Both default off (fast).
# Enable Think/reasoning mode (slower, deeper answers):
SCREEN_AGENT_CHATGPT_THINK=false
# Enable live web search on desktop captures (slower):
SCREEN_AGENT_SCREEN_WEB_SEARCH=false

# Optional screenshot-host fallback chain. First successful provider wins;
# HTTP 429 and other provider errors continue to the next entry.
SCREEN_AGENT_BIND_ADDR=127.0.0.1
SCREEN_AGENT_HOTKEY=CommandOrControl+Shift+S
SCREEN_AGENT_IMGLINK_UPLOAD=false
SCREEN_AGENT_IMAGE_UPLOAD_PROVIDERS=catbox,imgpile,postimages,imgbb,imglink
SCREEN_AGENT_IMGLINK_API_KEY=
SCREEN_AGENT_IMGPILE_URL=https://imgpile.com/uploads
SCREEN_AGENT_IMGPILE_API_TOKEN=
SCREEN_AGENT_POSTIMAGES_URL=https://api.postimage.org/1/upload
SCREEN_AGENT_POSTIMAGES_API_TOKEN=
SCREEN_AGENT_IMGBB_API_KEY=
